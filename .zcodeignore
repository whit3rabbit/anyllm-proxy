/target/
**/*.rs.bk

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
.syntext

# Environment
.env
.env.*
!.env.example
!.env.example.test
.anyllm.env
.anyllm.env.*
